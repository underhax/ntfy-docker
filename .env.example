# Host DAC execution identity (must be a unique, dedicated unprivileged UID:GID on your host)
APP_UID=
APP_GID=

# Image release tag
NTFY_VERSION='latest'

# General server configuration
NTFY_LISTEN_HTTP=':8080'
NTFY_BEHIND_PROXY='true'
NTFY_LOG_LEVEL='warn'
# Web application UI ('disable' for headless API-only).
# To enable Web UI under an unguessable secret subpath via Docker Secrets,
# comment out NTFY_WEB_ROOT here and provide ./secrets/ntfy_web_root instead (see README.md).
NTFY_WEB_ROOT='disable'

# Optional Web Push (RFC 8030 browser notifications when web app tab is closed)
# Public/private VAPID keys and contact email are mediated via Docker Secrets (see README.md).
# NTFY_WEB_PUSH_FILE='/data/webpush.db'
# NTFY_WEB_PUSH_STARTUP_QUERIES='pragma journal_mode = WAL; pragma synchronous = normal; pragma temp_store = memory; pragma busy_timeout = 15000; vacuum;'

# Optional iOS push notifications (Apple APNs upstream relay)
# Required if you use the official iOS app (Apple prohibits persistent background connections).
# Not needed for Android (background polling) or desktop browsers.
# NTFY_UPSTREAM_BASE_URL='https://ntfy.sh'

# SQLite message cache configuration
NTFY_CACHE_FILE='/data/cache.db'
NTFY_CACHE_DURATION='24h'
NTFY_CACHE_STARTUP_QUERIES='pragma journal_mode = WAL; pragma synchronous = normal; pragma temp_store = memory; pragma busy_timeout = 15000; vacuum;'

# SQLite authentication and authorization
NTFY_AUTH_FILE='/data/auth.db'
NTFY_AUTH_DEFAULT_ACCESS='deny-all'
NTFY_AUTH_STARTUP_QUERIES='pragma journal_mode = WAL; pragma synchronous = normal; pragma temp_store = memory; pragma busy_timeout = 15000; vacuum;'

# Attachment storage and limits
NTFY_ATTACHMENT_CACHE_DIR='/data/attachments'
NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT='5G'
NTFY_ATTACHMENT_FILE_SIZE_LIMIT='15M'
NTFY_ATTACHMENT_EXPIRY_DURATION='3h'
NTFY_VISITOR_ATTACHMENT_TOTAL_SIZE_LIMIT='100M'
NTFY_VISITOR_ATTACHMENT_DAILY_BANDWIDTH_LIMIT='500M'
